# 垃圾站只供仓库维护；GitHub Source archive / git archive 不发布淘汰物。
.trash export-ignore
.trash/** export-ignore
.work export-ignore
.work/** export-ignore
output export-ignore
output/** export-ignore

# 即使误受跟踪，notes 工作树仍不进入源码归档。
.work-notes export-ignore
.work-notes/** export-ignore
# React 预览产物的 manifest 以原始字节校验；各系统 checkout 必须保留 LF。
src/myth/webui/react/* text eol=lf
