# sdist 是可复现的当前源码；淘汰内容和本机生成物永不进入发布包。
include AGENTS.md CHANGELOG.md PRODUCT.md README.md DESIGN.md SECURITY.md start-myth.ps1
include .impeccable/design.json
recursive-include .impeccable/surfaces *.md
recursive-include docs *.md *.json *.png
recursive-include evals *.json
recursive-include examples *.json *.txt *.py *.md
# 完整当前代码/资源/门禁随源码发布，新增嵌套文件不再维护第二份扩展名清单。
graft scripts
graft tests
graft src/myth
prune .trash
prune .work
prune .venv
prune output
prune .runtime
prune .myth
prune secrets
global-exclude __pycache__ *.py[cod]
global-exclude .env .env.* *.pem *.key *.db *.db-shm *.db-wal *.sqlite *.sqlite3 *.sqlite*-shm *.sqlite*-wal
# 长任务进度与孤儿分支工作树属于开发状态，不是发布输入。
prune .work
prune .work-notes
