# sdist 是可复现的当前源码；淘汰内容和本机生成物永不进入发布包。
include AGENTS.md CHANGELOG.md PRODUCT.md README.md DESIGN.md SECURITY.md start-myth.ps1
include .impeccable/design.json
recursive-include .impeccable/surfaces *.md
recursive-include docs *.md *.json *.png
recursive-include evals *.json
recursive-include examples *.json *.txt
recursive-include scripts *.py
recursive-include tests *.py *.cjs
recursive-include src *.py *.html *.css *.js *.svg
include src/myth/webui/fonts/README.md
prune .trash
prune .work
prune .venv
prune output
prune .runtime
global-exclude __pycache__ *.py[cod]
# 长任务进度与孤儿分支工作树属于开发状态，不是发布输入。
prune .work
prune .work-notes
